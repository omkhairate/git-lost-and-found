#!/usr/bin/env python3
"""Search recoverable dropped Git stashes and export their patches."""

import argparse
import os
from pathlib import Path
import re
import subprocess
import sys


class RecoveryError(Exception):
    """An error that can be explained without a traceback."""


def git(*args):
    result = subprocess.run(
        ["git", "--no-pager", "--no-replace-objects", *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode:
        detail = result.stderr.decode(errors="replace").strip()
        raise RecoveryError(detail or f"git {args[0]} exited with {result.returncode}")
    return result.stdout


def commit(oid):
    headers, _, message = git("cat-file", "commit", oid).partition(b"\n\n")
    parents = [
        line.removeprefix(b"parent ").decode("ascii")
        for line in headers.splitlines()
        if line.startswith(b"parent ")
    ]
    return parents, message.partition(b"\n")[0]


def stash(oid):
    parents, subject = commit(oid)
    if len(parents) not in (2, 3):
        return None

    index_parents, index_subject = commit(parents[1])
    if index_parents != [parents[0]] or not index_subject.startswith(b"index on "):
        return None
    if len(parents) == 3:
        extra_parents, extra_subject = commit(parents[2])
        if extra_parents or not extra_subject.startswith(b"untracked files on "):
            return None
    return parents, subject


def patch(oid, parents):
    options = (
        "--binary", "--full-index", "--no-color", "--no-ext-diff",
        "--no-textconv", "--no-relative", "--no-renames",
        "--src-prefix=a/", "--dst-prefix=b/", "--submodule=short",
    )
    tracked = git("diff", *options, parents[0], oid, "--")
    if len(parents) == 2:
        return tracked
    untracked = git(
        "diff-tree", "--root", "--no-commit-id", "-r", "-p", *options,
        parents[2], "--",
    )
    return tracked + untracked


def contains_change(diff, query):
    in_hunk = False
    for line in diff.split(b"\n"):
        if line.startswith(b"diff --git "):
            in_hunk = False
        elif line.startswith(b"@@ "):
            in_hunk = True
        elif in_hunk and line.startswith((b"+", b"-")) and query in line[1:]:
            return True
    return False


def search(query):
    matches = []
    objects = git("fsck", "--full", "--unreachable", "--no-progress")
    for line in objects.splitlines():
        if not line.startswith(b"unreachable commit "):
            continue
        oid = line.split()[2].decode("ascii")
        candidate = stash(oid)
        if candidate is None:
            continue
        parents, subject = candidate
        if contains_change(patch(oid, parents), query):
            matches.append((oid, subject))
    for oid, subject in sorted(matches):
        print(oid, subject.decode(errors="replace"))
    if not matches:
        print("No matching dropped stashes found.", file=sys.stderr)
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    find = commands.add_parser("search", help="search added and removed lines for literal text")
    find.add_argument("text")
    show = commands.add_parser("show", help="preview or export a stash patch")
    show.add_argument("object_id")
    show.add_argument("-o", "--output", type=Path, help="write to a new patch file")
    args = parser.parse_args()

    if args.command == "search" and (not args.text or "\n" in args.text):
        parser.error("search text must be a single non-empty line")
    if args.command == "show" and not re.fullmatch(r"[0-9a-fA-F]{4,64}", args.object_id):
        parser.error("show expects a Git object ID")

    try:
        git("rev-parse", "--git-dir")
        if args.command == "search":
            return search(os.fsencode(args.text))
        oid = git("rev-parse", "--verify", f"{args.object_id}^{{commit}}").strip().decode("ascii")
        candidate = stash(oid)
        if candidate is None:
            raise RecoveryError(f"{oid} is not a recognized Git stash")
        diff = patch(oid, candidate[0])
        if args.output:
            with args.output.open("xb") as output:
                output.write(diff)
        else:
            sys.stdout.buffer.write(diff)
        return 0
    except (RecoveryError, OSError) as error:
        print(f"git-lost-found: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
